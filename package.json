{
  "name": "text-to-excel-converter",
  "version": "1.0.0",
  "private": true,
  "description": "Convert pasted or uploaded text (CSV, TSV, pipe, semicolon, plain lines) into formatted Excel .xlsx files, entirely in the browser.",
  "license": "MIT",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/styles.css --minify",
    "build": "npm run build:css",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/styles.css --watch",
    "test": "node tests/run-tests.js",
    "serve": "npx --yes serve public -l 3000"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "engines": {
    "node": ">=18"
  }
}
